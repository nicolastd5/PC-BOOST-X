<Window x:Class="BoostParaPc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BoostParaPc.ViewModels"
        xmlns:views="clr-namespace:BoostParaPc.Views"
        Title="Project Boost X"
        Width="1180" Height="760"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Cada viewmodel de tela tem a sua View; o ContentControl escolhe pelo tipo. -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizationsViewModel}"><views:OptimizationsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamesViewModel}"><views:GamesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupViewModel}"><views:CleanupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}"><views:StartupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonitorViewModel}"><views:MonitorView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navegação -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentGradient}" VerticalAlignment="Center">
                            <TextBlock Text="X" FontWeight="Bold" FontSize="20" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Project Boost X" FontWeight="Bold" FontSize="15" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,16">
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12,10">
                        <StackPanel>
                            <TextBlock x:Name="AdminBadge" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SystemInfo.OsName}" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding SystemInfo.CpuName}" Style="{StaticResource MutedText}" FontSize="10" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0">
                                <Run Text="RAM " /><Run Text="{Binding SystemInfo.TotalRamGb, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" GB · " /><Run Text="{Binding SystemInfo.DiskType, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ListBox ItemsSource="{x:Static vm:MainViewModel.NavItems}" SelectedValue="{Binding CurrentPage, Mode=TwoWay}" SelectedValuePath="Key"
                         Margin="0,6,0,0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Navegação principal">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="14,11" Margin="10,2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="bd" Property="BorderThickness" Value="1" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#330B8CFF" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Gravação em andamento: barra fina com mensagem. A navegação continua livre. -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Padding="24,8">
                <DockPanel>
                    <Button Content="Cancelar" Style="{StaticResource DangerButton}" DockPanel.Dock="Right" Padding="12,4" Margin="12,0,0,0"
                            Command="{Binding CancelOperationCommand}" Visibility="{Binding CanCancelOperation, Converter={StaticResource BoolToVis}}" />
                    <StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" IsTabStop="False" />

            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="18,9">
                <DockPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
