<UserControl x:Class="BoostParaPc.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18,24,8">
        <StackPanel>
            <TextBlock Text="Histórico" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Tudo o que este programa aplicou ou reverteu, do mais recente para o mais antigo." />

            <WrapPanel Margin="0,0,0,12">
                <ComboBox SelectedIndex="{Binding Filter}" Width="170" Margin="0,0,10,6" AutomationProperties.Name="Filtrar histórico">
                    <ComboBoxItem Content="Tudo" />
                    <ComboBoxItem Content="Só concluídos" />
                    <ComboBoxItem Content="Só falhas" />
                </ComboBox>
                <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" Command="{Binding LoadCommand}" Margin="0,0,8,6" />
                <Button Content="Exportar para suporte" Style="{StaticResource SecondaryButton}" Command="{Binding ExportCommand}" Margin="0,0,8,6"
                        ToolTip="Cria um zip com o histórico e as informações do PC. Nada é enviado." />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            </WrapPanel>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ItemCard}" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding When}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  ·  " Foreground="{StaticResource TextMutedBrush}" /><Run Text="{Binding Action, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" /></TextBlock>
                                    <TextBlock Text="{Binding Entry.Message}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Result}" VerticalAlignment="Center" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Entry.Ok}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="3" Content="Reverter" Style="{StaticResource DangerButton}" Padding="12,5"
                                        Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Reverter {0}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
