<UserControl x:Class="BoostParaPc.Views.OptimizationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,18,24,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Otimizações" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,12"
                       Text="Cada ajuste pode ser aplicado e revertido sozinho. Itens de risco Moderado e Avançado só entram se você marcar." />
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
        </StackPanel>

        <!-- Filtros e presets -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12,14,6">
            <StackPanel>
                <WrapPanel>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,10,6"
                             AutomationProperties.Name="Buscar otimização" ToolTip="Buscar por nome ou descrição" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label"
                              Width="170" Margin="0,0,10,6" AutomationProperties.Name="Filtrar por categoria" />
                    <ComboBox ItemsSource="{Binding Risks}" SelectedItem="{Binding SelectedRisk}" DisplayMemberPath="Label"
                              Width="150" Margin="0,0,10,6" AutomationProperties.Name="Filtrar por risco" />
                    <Button Content="Preset Seguro" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Command="{Binding PresetSafeCommand}"
                            ToolTip="Marca só os itens de risco Seguro indicados para este PC" />
                    <Button Content="Preset Equilibrado" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Command="{Binding PresetBalancedCommand}"
                            ToolTip="Marca itens Seguros e Moderados indicados para este PC. Nunca marca avançados" />
                    <Button Content="Desmarcar" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Command="{Binding ClearSelectionCommand}" />
                    <Button Content="Aplicar selecionadas" Style="{StaticResource PrimaryButton}" Margin="0,0,10,6" Command="{Binding ApplySelectedCommand}" />
                    <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,0,6">
                        <Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=" marcadas" />
                    </TextBlock>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Lista virtualizada + seções extras no fim -->
        <ListBox Grid.Row="2" ItemsSource="{Binding View}" ItemTemplate="{StaticResource OptimizationItemTemplate}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                 KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="Lista de otimizações">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <ItemsPresenter />

                            <!-- Ferramentas -->
                            <TextBlock Text="Ferramentas" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
                            <ItemsControl ItemsSource="{Binding DataContext.Tools, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          ItemTemplate="{StaticResource OptimizationItemTemplate}" />

                            <!-- Apps pré-instalados -->
                            <TextBlock Text="Apps pré-instalados" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DataContext.BloatStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding DataContext.Bloat, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding App.Name}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Procurar" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.FindBloatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <Button Content="Remover marcados" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Command="{Binding DataContext.RemoveBloatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- DNS -->
                            <TextBlock Text="DNS" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DataContext.DnsStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding DataContext.DnsResults, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Primary}" Style="{StaticResource MutedText}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding MedianMs, StringFormat={}{0:0} ms, TargetNullValue=sem resposta}" Foreground="{StaticResource AccentBrush}" />
                                                    <Button Grid.Column="3" Content="Usar" Style="{StaticResource SecondaryButton}" Padding="12,5"
                                                            Command="{Binding DataContext.UseDnsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Usar DNS {0}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Testar DNS" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.TestDnsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <Button Content="Restaurar DNS anterior" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Command="{Binding DataContext.RestoreDnsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </ControlTemplate>
            </ListBox.Template>
        </ListBox>
    </Grid>
</UserControl>
