<UserControl x:Class="BoostParaPc.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18,24,8">
        <StackPanel>
            <TextBlock Text="Inicialização" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="O que abre com o Windows: programas do Registro, pasta Inicializar e tarefas agendadas de logon. Desativar acelera o boot e libera RAM; dá para reativar." />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,10">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Recarregar lista" Style="{StaticResource SecondaryButton}" Command="{Binding LoadCommand}" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ItemCard}" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Command}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource MutedText}" FontSize="11">
                                                <Run Text="Fonte: " /><Run Text="{Binding Source, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Desativar" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding DataContext.DisableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Margin="0,0,6,0"
                                                    Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Desativar {0}}" />
                                            <Button Content="Reativar" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding DataContext.EnableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsEnabled, Converter={StaticResource NotBoolToVis}}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Reativar {0}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
