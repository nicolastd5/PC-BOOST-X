<UserControl x:Class="BoostParaPc.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18,24,8">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Configurações" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Como o programa se comporta." Style="{StaticResource PageSubtitle}" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Segurança" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="Exigir ponto de restauração antes de aplicar" IsChecked="{Binding RequireRestorePoint}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="24,0,0,10"
                               Text="Se a criação falhar, a aplicação é interrompida. Desligar permite aplicar sem ponto de restauração." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Criar ponto agora" Style="{StaticResource SecondaryButton}" Command="{Binding CreateRestorePointCommand}" />
                        <Button Content="Reverter tudo" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Command="{Binding RevertAllCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Modo Jogo automático" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="Ligar quando um jogo detectado abrir" IsChecked="{Binding AutoGameMode}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="24,0,0,10"
                               Text="Dá prioridade ao jogo, põe apps de fundo em modo de eficiência, silencia notificações e limpa a memória em espera. Tudo volta ao normal quando o jogo fecha. Fechar a janela minimiza para a bandeja." />
                    <CheckBox Content="Iniciar com o Windows (tarefa agendada, sem pedir permissão a cada logon)" IsChecked="{Binding StartWithWindows}" />
                    <TextBlock Text="Apps de fundo (um por linha, nome do .exe)" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding BackgroundApps, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Lista de apps de fundo" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               Text="O próprio jogo, anti-cheats, Discord, OBS e o áudio do Windows nunca são alterados, mesmo que estejam na lista." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Atualizações" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="Verificar se há versão nova ao abrir" IsChecked="{Binding CheckForUpdates}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Verificar agora" Style="{StaticResource SecondaryButton}" Command="{Binding CheckUpdateCommand}" />
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Sobre" Style="{StaticResource SectionTitle}" />
                    <TextBlock><Run Text="Project Boost X " /><Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,8"
                               Text="Nenhum dado seu é enviado a lugar nenhum. Tudo o que o programa altera tem backup e pode ser revertido." />
                    <TextBlock Text="{Binding DataFolder}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    <Button Content="Abrir pasta de dados" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding OpenDataFolderCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
