<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ProjectBoostX</AssemblyName>
    <RootNamespace>BoostParaPc</RootNamespace>
    <Version>3.0.0</Version>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Product>Project Boost X</Product>
    <AssemblyTitle>Project Boost X</AssemblyTitle>
    <Description>Otimizador de PC para jogos e tarefas — Project Boost X</Description>
    <Company>Project Boost X</Company>
  </PropertyGroup>

  <!-- Publicação: um único .exe que não exige .NET instalado. WPF não suporta trimming; não usar PublishTrimmed. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

</Project>
