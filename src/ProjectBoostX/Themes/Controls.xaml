<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:BoostParaPc"
                    xmlns:ctl="clr-namespace:BoostParaPc.Controls">

    <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    <local:BoolToVisibilityConverter x:Key="NotBoolToVis" Invert="True" />

    <!-- Componentes compartilhados: nenhuma tela define cor ou raio de borda por conta própria. -->

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="IconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Linha de lista (item de otimização, programa de inicialização, jogo) -->
    <Style x:Key="ItemCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Cor do texto de risco: verde, amarelo ou vermelho -->
    <Style x:Key="RiskText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Risk}" Value="Moderate">
                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Risk}" Value="Advanced">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Estado do item: Aplicado / Não aplicado / Falhou -->
    <Style x:Key="StateText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Applied">
                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Failed">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsAction}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CautionText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Caution}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NotRecommendedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding NotRecommendedReason}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ItemStatusText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Barra de aviso (informação por padrão; Success/Error pelo Tag) -->
    <Style x:Key="NoticeBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ChipBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Error">
                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
            <Trigger Property="Tag" Value="Success">
                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleText}" />

    <Style x:Key="PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- Contorno de foco visível para quem navega só pelo teclado -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" SnapsToDevicePixels="True" Stroke="{StaticResource AccentBrush}"
                               StrokeThickness="2" RadiusX="8" RadiusY="8" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cartão de otimização, usado na tela Otimizações. Os comandos vêm do DataContext da tela (UserControl). -->
    <DataTemplate x:Key="OptimizationItemTemplate">
        <Border Style="{StaticResource ItemCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,3,12,0"
                          AutomationProperties.Name="{Binding Name}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" />
                    <TextBlock Style="{StaticResource CautionText}">
                        <Run Text="Quando não usar: " /><Run Text="{Binding Caution, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource NotRecommendedText}">
                        <Run Text="Não recomendado para este PC: " /><Run Text="{Binding NotRecommendedReason, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource ItemStatusText}" />
                    <WrapPanel Margin="0,6,0,0">
                        <Border Style="{StaticResource Chip}">
                            <TextBlock FontSize="11" Foreground="{StaticResource AccentBrush}">
                                <Run Text="Impacto: " /><Run Text="{Binding Impact, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <TextBlock Style="{StaticResource RiskText}">
                                <Run Text="Risco: " /><Run Text="{Binding RiskDisplay, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{Binding CategoryDisplay}" />
                        </Border>
                        <Border Style="{StaticResource Chip}" Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="11" Foreground="{StaticResource Accent2Brush}" Text="Requer reinício" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{Binding StateDisplay}" Style="{StaticResource StateText}" />
                    <Button Margin="0,6,0,0" MinWidth="86"
                            Command="{Binding DataContext.ApplyItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Aplicar {0}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Content" Value="Aplicar" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Applied">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Reverter" Margin="0,6,0,0" MinWidth="86"
                            Command="{Binding DataContext.RevertItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Reverter {0}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Applied">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
