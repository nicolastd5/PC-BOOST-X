<Application x:Class="BoostParaPc.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BoostParaPc"
             xmlns:conv="clr-namespace:BoostParaPc.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:PageToVisibilityConverter x:Key="PageToVis" />
            <local:BoolToVisibilityConverter x:Key="BoolToVis" />
            <local:BoolToVisibilityConverter x:Key="NotBoolToVis" Invert="True" />
            <conv:PathToImageSourceConverter x:Key="PathToImage" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
